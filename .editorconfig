root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1,sln,vcxproj,csproj}]
end_of_line = crlf

[*.{cpp,h,hpp,inl,cs}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,uproject,uplugin,ini}]
indent_style = space
indent_size = 2
